{
  "name": "ielts-study-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的雅思备考静态学习工具：SM-2 单词、同义替换、长难句、写作、口语与模考计时。",
  "scripts": {
    "parse:words": "node scripts/parse-word-md.mjs",
    "predev": "npm run parse:words",
    "build:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --watch",
    "dev": "node serve.js",
    "prepreview": "npm run parse:words",
    "preview": "node serve.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
